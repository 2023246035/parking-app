# API-Only Docker Environment Configuration
# Copy this to .env for API deployment

# Database Configuration
POSTGRES_DB=parkmycar
POSTGRES_USER=parkmycar_user
POSTGRES_PASSWORD=changeme123_secure_password_here
POSTGRES_PORT=5432

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
APP_ENV=production
SECRET_KEY=generate-a-secure-random-secret-key-here

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# AWS SES Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
SES_SENDER_EMAIL=noreply@yourdomain.com

# Email Settings
EMAIL_PROVIDER=console
# Change to 'ses' for production

# Redis (Optional - for caching)
REDIS_PORT=6379

# Nginx API Gateway (Optional)
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# Optional: External database URL
# DATABASE_URL=postgresql://user:password@host:port/database
