# Dockerfile for ParkMyCar AI Microservice
# This runs only the AI capabilities without Reflex or main Core Backend

FROM python:3.11-slim

# Set environment variables
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

# Install system dependencies
RUN apt-get update && apt-get install -y \
    curl \
    bash \
    && rm -rf /var/lib/apt/lists/*

# Create app directory
WORKDIR /app

# Copy requirements and install dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Install additional API-specific dependencies
RUN pip install --no-cache-dir \
    uvicorn[standard] \
    python-multipart

# Copy application code
COPY app/ ./

# Expose AI API port
EXPOSE 8001

# Set Python path
ENV PYTHONPATH=/app

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=20s --retries=3 \
    CMD curl -f http://localhost:${PORT:-8001}/health || exit 1

# Run the FastAPI application with uvicorn
CMD ["bash", "-c", "uvicorn ai.main:app --host 0.0.0.0 --port ${PORT:-8001}"]
